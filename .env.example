# Copy to .env and fill in. Never commit .env.

# Spotify (playback + catalog). Create an app at developer.spotify.com, add the redirect URI below.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# ElevenLabs conversational agent (voice + hosted LLM)
ELEVENLABS_API_KEY=

# Last.fm: live listening updates (polls your recent scrobbles)
LASTFM_API_KEY=
LASTFM_USERNAME=

# Optional: BPM cross-check during enrichment
GETSONGBPM_API_KEY=

# Optional: path to the project that built the knowledge graph (artist-name resolver)
AI_DJ_DIR=

CORS_ORIGINS=http://localhost:5173
